# Copie este arquivo para ".env" para testar no computador (npm run dev).
# O ".env" nunca vai para o GitHub. Em produção, configure no hPanel da Hostinger.

# Endereço secreto do painel (12+ caracteres; invente um, não use este exemplo)
PAINEL_CAMINHO=/gestao-troque-este-endereco

# Usuários do painel: gere cada linha com "npm run criar-usuario"
PAINEL_USUARIOS=

# Login do GitHub no painel (docs/painel-do-blog.md)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Avaliações automáticas do Google (docs/avaliacoes-google.md)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
